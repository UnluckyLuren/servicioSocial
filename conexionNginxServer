# 1. JELLYFIN - PÚBLICO PERO RESTRINGIDO POR IP
server {
    listen 80;
    server_name 129.146.176.154;

    # SEGURIDAD: Solo permite tu Wi-Fi, bloquea a los demás
    allow 187.244.97.169;
    deny all;

    # Descomentar si tu IP de casa cambia mucho (IP Dinámica) y prefieres borrar allow/deny.
    # En ese caso, la seguridad recae en tener contraseñas fuertes en Jellyfin.

    location / {
        proxy_pass http://127.0.0.1:8097;

        # Parámetros estándar para media streaming y websockets
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Soporte WebSocket para Jellyfin
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Evitar cortes en archivos grandes
        client_max_body_size 20M;
        proxy_buffering off;
    }
}

# 2. N8N - TOTALMENTE PRIVADO VÍA TAILSCALE
server {
    # Solo escucha peticiones que lleguen por la VPN
    listen 100.120.212.113:80;

    location / {
        # Puerto por defecto de n8n en CasaOS
        proxy_pass http://127.0.0.1:5678;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Websockets para n8n UI
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
